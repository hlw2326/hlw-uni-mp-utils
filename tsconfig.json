{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "isolatedModules": true,
    "types": [
      "@dcloudio/types"
    ]
  },
  "include": [
    "src"
  ]
}
